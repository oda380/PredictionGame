# WalletConnect Project ID (Required for RainbowKit)
# Get one at https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Base Mainnet RPC URL (Recommended: Alchemy, Infura, etc.)
# If left empty, it will fallback to public RPCs (not recommended for production).
# Alchemy API Key for RPC (client-side - exposed in browser but rate-limited per domain)
# This is safer than exposing the full RPC URL
NEXT_PUBLIC_ALCHEMY_API_KEY=your_alchemy_api_key_here

# Chain ID (Default: 8453 for Base Mainnet)
NEXT_PUBLIC_BASE_CHAIN_ID=8453

# Game Contract Address
NEXT_PUBLIC_GAME_CONTRACT_ADDRESS=

# Chainlink Price Feed Address (ETH/USD on Base)
NEXT_PUBLIC_ETH_USD_PRICE_FEED_ADDRESS=

# Network Name
NEXT_PUBLIC_BASE_NETWORK_NAME="Base Mainnet"

# Block Explorer URL
NEXT_PUBLIC_BASE_BLOCK_EXPLORER_URL="https://basescan.org"


# CoinGecko API Key for price feeds
CG_API_KEY=your_coingecko_api_key_here
