import React, { useState, useEffect, useCallback } from 'react';
// If you installed ethers.js v6 via npm (recommended):
import { ethers } from 'ethers';

// --- Contract Configuration ---
const contractAddress = "0xD80b8E41D3B04aeEBEdD43C4157449987122e9fC"; 
const targetNetworkId = '0x2105'; // Base Mainnet Chain ID (8453 in decimal)
const targetNetworkName = "Base Mainnet";
const blockExplorerUrl = "https://basescan.org";

// --- Contract ABI ---
// ENSURE THIS ABI MATCHES YOUR `BTCPricePredictionGame.json` ARTIFACT
// The "name" for the token gating enabled function should be "tokenGatingEnabled"
const contractABI = [
    {"inputs":[{"internalType":"address","name":"_priceFeedAddress","type":"address"},{"internalType":"uint256","name":"_initialEntryFee","type":"uint256"},{"internalType":"uint256","name":"_initialPrizePoolPercentage","type":"uint256"},{"internalType":"uint256","name":"_initialMaxBetAmount","type":"uint256"}],"stateMutability":"nonpayable","type":"constructor"},{"inputs":[],"name":"OwnableUnauthorizedAccount","type":"error"},{"inputs":[{"internalType":"address","name":"target","type":"address"}],"name":"AddressEmptyCode","type":"error"},{"inputs":[{"internalType":"address","name":"account","type":"address"}],"name":"AddressInsufficientBalance","type":"error"},{"inputs":[],"name":"FailedInnerCall","type":"error"},{"inputs":[{"internalType":"address","name":"owner","type":"address"}],"name":"OwnableInvalidOwner","type":"error"},{"inputs":[],"name":"PausableEnforcedPause","type":"error"},{"inputs":[],"name":"PausableExpectedPause","type":"error"},{"inputs":[{"internalType":"address","name":"token","type":"address"}],"name":"SafeERC20FailedOperation","type":"error"},{"anonymous":false,"inputs":[{"indexed":true,"internalType":"address","name":"to","type":"address"},{"indexed":false,"internalType":"uint256","name":"amount","type":"uint256"}],"name":"AdminFeesWithdrawn","type":"event"},{"anonymous":false,"inputs":[{"indexed":true,"internalType":"address","name":"user","type":"address"},{"indexed":false,"internalType":"uint256","name":"rawPrediction","type":"uint256"},{"indexed":true,"internalType":"uint256","name":"roundId","type":"uint256"},{"indexed":false,"internalType":"uint256","name":"amount","type":"uint256"}],"name":"BetPlaced","type":"event"},{"anonymous":false,"inputs":[{"indexed":true,"internalType":"address","name":"user","type":"address"},{"indexed":true,"internalType":"uint256","name":"roundId","type":"uint256"}],"name":"BetCancelled","type":"event"},{"anonymous":false,"inputs":[{"indexed":false,"internalType":"uint256","name":"newEntryFee","type":"uint256"}],"name":"EntryFeeChanged","type":"event"},{"anonymous":false,"inputs":[],"name":"GamePaused","type":"event"},{"anonymous":false,"inputs":[],"name":"GameUnpaused","type":"event"},{"anonymous":false,"inputs":[{"indexed":true,"internalType":"address","name":"tokenAddress","type":"address"},{"indexed":false,"internalType":"uint256","name":"minBalance","type":"uint256"}],"name":"GatingTokenSet","type":"event"},{"anonymous":false,"inputs":[{"indexed":false,"internalType":"uint256","name":"newMaxBetAmount","type":"uint256"}],"name":"MaxBetAmountChanged","type":"event"},{"anonymous":false,"inputs":[{"indexed":true,"internalType":"address","name":"newOracle","type":"address"}],"name":"OracleAddressChanged","type":"event"},{"anonymous":false,"inputs":[{"indexed":true,"internalType":"address","name":"previousOwner","type":"address"},{"indexed":true,"internalType":"address","name":"newOwner","type":"address"}],"name":"OwnershipTransferred","type":"event"},{"anonymous":false,"inputs":[{"indexed":false,"internalType":"address","name":"account","type":"address"}],"name":"Paused","type":"event"},{"anonymous":false,"inputs":[{"indexed":true,"internalType":"address","name":"winner","type":"address"},{"indexed":true,"internalType":"uint256","name":"roundId","type":"uint256"},{"indexed":false,"internalType":"uint256","name":"amount","type":"uint256"}],"name":"PrizeClaimed","type":"event"},{"anonymous":false,"inputs":[{"indexed":false,"internalType":"uint256","name":"newPercentage","type":"uint256"}],"name":"PrizePoolPercentageChanged","type":"event"},{"anonymous":false,"inputs":[{"indexed":true,"internalType":"uint256","name":"roundId","type":"uint256"},{"indexed":false,"internalType":"uint256","name":"roundEndTime","type":"uint256"},{"indexed":false,"internalType":"uint256","name":"predictionDeadline","type":"uint256"}],"name":"RoundCreated","type":"event"},{"anonymous":false,"inputs":[{"indexed":true,"internalType":"uint256","name":"roundId","type":"uint256"},{"indexed":false,"internalType":"uint256","name":"actualPrice","type":"uint256"},{"indexed":false,"internalType":"uint256","name":"numberOfWinners","type":"uint256"}],"name":"RoundResolved","type":"event"},{"anonymous":false,"inputs":[{"indexed":false,"internalType":"bool","name":"enabled","type":"bool"}],"name":"TokenGatingToggled","type":"event"},{"anonymous":false,"inputs":[{"indexed":false,"internalType":"address","name":"account","type":"address"}],"name":"Unpaused","type":"event"},{"inputs":[],"name":"MAX_WINNERS","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"PRICE_DECIMALS","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"STALE_PRICE_THRESHOLD","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"USER_PREDICTION_DECIMALS","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"accumulatedAdminFees","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"uint256","name":"","type":"uint256"},{"internalType":"address","name":"","type":"address"}],"name":"bets","outputs":[{"internalType":"uint256","name":"rawPrediction","type":"uint256"},{"internalType":"uint256","name":"amount","type":"uint256"},{"internalType":"bool","name":"claimed","type":"bool"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"uint256","name":"","type":"uint256"},{"internalType":"uint256","name":"","type":"uint256"}],"name":"bettorsInRound","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"uint256","name":"_roundId","type":"uint256"}],"name":"cancelBet","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"uint256","name":"_roundId","type":"uint256"}],"name":"claimPrize","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"uint256","name":"_roundEndTime","type":"uint256"},{"internalType":"uint256","name":"_predictionDeadline","type":"uint256"}],"name":"createRound","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"currentRoundId","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"entryFee","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"gatingToken","outputs":[{"internalType":"contract IERC20","name":"","type":"address"}],"stateMutability":"view","type":"function"},
    {"inputs":[],"name":"tokenGatingEnabled","outputs":[{"internalType":"bool","name":"","type":"bool"}],"stateMutability":"view","type":"function"}, // Corrected name based on user feedback
    {"inputs":[],"name":"getBtcPriceFromOracle","outputs":[{"internalType":"int256","name":"","type":"int256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"getLatestCreatedRoundId","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"getNextRoundId","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"maxBetAmount","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"minGatingTokenBalance","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"owner","outputs":[{"internalType":"address","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"pauseGame","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"paused","outputs":[{"internalType":"bool","name":"","type":"bool"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"uint256","name":"_rawPrediction","type":"uint256"},{"internalType":"uint256","name":"_roundId","type":"uint256"}],"name":"placeBet","outputs":[],"stateMutability":"payable","type":"function"},{"inputs":[],"name":"priceFeed","outputs":[{"internalType":"contract AggregatorV3Interface","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"prizePoolPercentage","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[],"name":"renounceOwnership","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"uint256","name":"_roundId","type":"uint256"}],"name":"resolveRound","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"uint256","name":"","type":"uint256"}],"name":"rounds","outputs":[{"internalType":"uint256","name":"roundEndTime","type":"uint256"},{"internalType":"uint256","name":"predictionDeadline","type":"uint256"},{"internalType":"bool","name":"resolved","type":"bool"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"uint256","name":"_newEntryFee","type":"uint256"}],"name":"setEntryFee","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"_tokenAddress","type":"address"},{"internalType":"uint256","name":"_minBalance","type":"uint256"}],"name":"setGatingToken","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"uint256","name":"_newMaxBetAmount","type":"uint256"}],"name":"setMaxBetAmount","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"address","name":"_oracleAddress","type":"address"}],"name":"setOracleAddress","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"uint256","name":"_newPercentage","type":"uint256"}],"name":"setPrizePoolPercentage","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"bool","name":"_enable","type":"bool"}],"name":"toggleTokenGating","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"uint256","name":"","type":"uint256"}],"name":"totalCollectedPerRound","outputs":[{"internalType":"uint256","name":"","type":"uint256"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address","name":"newOwner","type":"address"}],"name":"transferOwnership","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[],"name":"unpauseGame","outputs":[],"stateMutability":"nonpayable","type":"function"},{"inputs":[{"internalType":"uint256","name":"","type":"uint256"},{"internalType":"uint256","name":"","type":"uint256"}],"name":"winners","outputs":[{"internalType":"address payable","name":"","type":"address"}],"stateMutability":"view","type":"function"},{"inputs":[{"internalType":"address payable","name":"_to","type":"address"}],"name":"withdrawAdminFees","outputs":[],"stateMutability":"nonpayable","type":"function"}
];

// --- Helper Components ---
const Notification = ({ message, type, onDismiss }) => {
    if (!message) return null;
    const bgColor = type === 'error' ? 'bg-red-500' : 'bg-green-500';
    return (
        <div className={`fixed bottom-5 right-5 text-white p-4 rounded-lg shadow-lg ${bgColor} z-50 transition-opacity duration-300 ease-in-out`}>
            {message}
            <button onClick={onDismiss} className="ml-4 font-bold hover:text-gray-200">X</button>
        </div>
    );
};

const Card = ({ children, title, titleColor = "text-blue-600", className = "" }) => (
    <div className={`bg-white p-6 rounded-lg shadow-md mb-6 ${className}`}>
        {title && <h2 className={`text-xl font-semibold mb-4 ${titleColor}`}>{title}</h2>}
        {children}
    </div>
);

const Input = ({ label, id, type = "text", value, onChange, placeholder, required, step, min, max, name, defaultValue }) => (
    <div className="mb-4">
        <label htmlFor={id} className="block text-sm font-medium text-gray-700 mb-1">{label}</label>
        <input
            type={type}
            id={id}
            name={name || id}
            value={value}
            defaultValue={defaultValue}
            onChange={onChange}
            placeholder={placeholder}
            required={required}
            step={step}
            min={min}
            max={max}
            className="mt-1 block w-full px-3 py-2 bg-white border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
        />
    </div>
);

const Button = ({ children, onClick, type = "button", variant = "primary", className = "", disabled = false }) => {
    const baseStyle = "px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium focus:outline-none focus:ring-2 focus:ring-offset-2 transition-colors duration-150 ease-in-out";
    let variantStyle = "";
    switch (variant) {
        case "secondary": variantStyle = "text-white bg-gray-600 hover:bg-gray-700 focus:ring-gray-500"; break;
        case "danger": variantStyle = "text-white bg-red-600 hover:bg-red-700 focus:ring-red-500"; break;
        case "warning": variantStyle = "text-white bg-amber-500 hover:bg-amber-600 focus:ring-amber-400"; break;
        default: variantStyle = "text-white bg-blue-600 hover:bg-blue-700 focus:ring-blue-500";
    }
    return (
        <button
            type={type}
            onClick={onClick}
            disabled={disabled}
            className={`${baseStyle} ${variantStyle} ${className} ${disabled ? 'opacity-50 cursor-not-allowed' : ''}`}
        >
            {children}
        </button>
    );
};

function App() {
    const [provider, setProvider] = useState(null);
    const [signer, setSigner] = useState(null);
    const [contract, setContract] = useState(null);
    const [userAddress, setUserAddress] = useState(null);
    const [networkInfo, setNetworkInfo] = useState({ name: '', chainId: '' });
    const [contractOwner, setContractOwner] = useState(null);
    const [isAdmin, setIsAdmin] = useState(false);
    const [notification, setNotification] = useState({ message: '', type: '' });
    const [nextRoundId, setNextRoundId] = useState('N/A');
    const [latestCreatedRoundId, setLatestCreatedRoundId] = useState('N/A');
    const [entryFee, setEntryFee] = useState('N/A');
    const [gamePaused, setGamePaused] = useState('N/A');
    const [queryRoundId, setQueryRoundId] = useState('');
    const [queriedRoundInfo, setQueriedRoundInfo] = useState(null);
    const [gatingEnabled, setGatingEnabled] = useState(false);
    const [gatingTokenDisplay, setGatingTokenDisplay] = useState('N/A');
    const [gatingMinBalanceDisplay, setGatingMinBalanceDisplay] = useState('N/A');

    const showNotif = (message, type = 'success') => {
        setNotification({ message, type });
        setTimeout(() => setNotification({ message: '', type: '' }), 5000);
    };

    const formatEth = useCallback((weiValue) => {
        if (!weiValue || typeof ethers === 'undefined' || !ethers.formatEther) return '0';
        try {
            return ethers.formatEther(weiValue);
        } catch (e) {
            console.error("Error formatting ETH:", e, weiValue);
            return 'Error';
        }
    }, []);

    const formatTimestamp = (timestamp) => {
        if (!timestamp || timestamp.toString() === "0") return "N/A";
        return new Date(Number(timestamp) * 1000).toLocaleString();
    };

    const connectWallet = useCallback(async () => {
        console.log("Attempting to connect wallet...");
        if (typeof ethers === 'undefined' || !ethers || typeof ethers.BrowserProvider !== 'function') {
            showNotif("Ethers.js library (v6) not loaded correctly. BrowserProvider is missing. Please check console.", "error");
            console.error("Ethers object is undefined, or BrowserProvider is not a function. Ensure 'ethers' v6 is correctly installed and imported.", ethers);
            return;
        }

        if (typeof window.ethereum !== 'undefined') {
            try {
                const web3Provider = new ethers.BrowserProvider(window.ethereum, "any"); 
                const accounts = await web3Provider.send("eth_requestAccounts", []);
                if (accounts.length === 0) {
                    showNotif("No accounts found. Please ensure your wallet is set up.", "error");
                    return;
                }
                const currentSigner = await web3Provider.getSigner();
                const address = await currentSigner.getAddress();
                
                setProvider(web3Provider);
                setSigner(currentSigner);
                setUserAddress(address);

                const network = await web3Provider.getNetwork();
                setNetworkInfo({ name: network.name, chainId: Number(network.chainId) });

                if (network.chainId.toString() !== parseInt(targetNetworkId, 16).toString()) {
                    showNotif(`Please connect to ${targetNetworkName} (Chain ID: ${targetNetworkId}). You are on ${network.name}.`, "error");
                    try {
                        await window.ethereum.request({
                            method: 'wallet_switchEthereumChain',
                            params: [{ chainId: targetNetworkId }],
                        });
                        const switchedNetwork = await web3Provider.getNetwork();
                        setNetworkInfo({ name: switchedNetwork.name, chainId: Number(switchedNetwork.chainId) });
                    } catch (switchError) {
                        if (switchError.code === 4902) {
                            showNotif(`Network ${targetNetworkName} not found in your wallet. Please add it.`, "error");
                        } else {
                            console.error("Failed to switch network:", switchError);
                            showNotif("Failed to switch network.", "error");
                        }
                        return;
                    }
                }
                
                const gameContract = new ethers.Contract(contractAddress, contractABI, currentSigner);
                setContract(gameContract); 
                console.log("Contract instance created in connectWallet:", gameContract);
                if (gameContract && typeof gameContract.getNextRoundId === 'function') {
                    console.log("getNextRoundId function IS available on contract instance in connectWallet.");
                    try {
                        const initialNextRound = await gameContract.getNextRoundId();
                        console.log("Initial getNextRoundId call successful in connectWallet, result:", initialNextRound.toString());
                    } catch (e) {
                        console.error("Initial getNextRoundId call FAILED in connectWallet:", e);
                         showNotif(`Initial contract call failed: ${e.message}`, "error");
                    }
                } else {
                    console.error("getNextRoundId function IS NOT available on contract instance in connectWallet. ABI or instantiation issue likely.");
                }
                showNotif("Wallet connected successfully!", "success");

            } catch (error) {
                console.error("Error connecting wallet:", error);
                showNotif(`Failed to connect wallet: ${error.message || 'Unknown error'}`, "error");
            }
        } else {
            showNotif("MetaMask (or a compatible wallet) is not installed. Please install it to use this dApp.", "error");
        }
    }, []);

    const loadGameData = useCallback(async () => {
        console.log("loadGameData called. Contract object:", contract);
        console.log("User address:", userAddress);

        if (!contract || !userAddress) {
            console.log("loadGameData: Contract or userAddress not available yet. Skipping.");
            return;
        }
        if (typeof contract.getNextRoundId !== 'function') { 
            console.error("loadGameData: contract.getNextRoundId is not a function. Contract object might be invalid or ABI issue.");
            showNotif("Contract interaction error. Check ABI and console.", "error");
            return;
        }

        try {
            console.log("Attempting to call contract.getNextRoundId()...");
            const nextId = await contract.getNextRoundId();
            setNextRoundId(nextId.toString());
            console.log("getNextRoundId successful, result:", nextId.toString());

            const latestId = await contract.getLatestCreatedRoundId();
            setLatestCreatedRoundId(latestId.toString());
            
            const fee = await contract.entryFee();
            setEntryFee(formatEth(fee));
            
            const pausedStatus = await contract.paused();
            setGamePaused(pausedStatus ? "Yes" : "No");
            
            const ownerAddr = await contract.owner();
            setContractOwner(ownerAddr);
            setIsAdmin(ownerAddr && userAddress && ownerAddr.toLowerCase() === userAddress.toLowerCase());
            
            // Call the function with lowercase 't' as per user confirmation
            console.log("Attempting to call contract.tokenGatingEnabled()...");
            if (typeof contract.tokenGatingEnabled !== 'function') {
                console.error("CRITICAL: contract.tokenGatingEnabled is NOT a function!");
                showNotif("Error: tokenGatingEnabled function missing. Check ABI.", "error");
                setGatingEnabled(false); 
            } else {
                const enabled = await contract.tokenGatingEnabled();
                setGatingEnabled(enabled);
                console.log("tokenGatingEnabled successful, result:", enabled);
            }
            
            const tokenAddr = await contract.gatingToken();
            setGatingTokenDisplay(tokenAddr === (ethers ? ethers.ZeroAddress : "0x0000000000000000000000000000000000000000") ? "N/A" : tokenAddr);
            setGatingMinBalanceDisplay((await contract.minGatingTokenBalance()).toString());
            console.log("Gating token info loaded.");

        } catch (error) {
            console.error("Error loading game data inside try-catch:", error);
            if (error.code === 'CALL_EXCEPTION') {
                 showNotif(`Contract call reverted: ${error.reason || "Missing revert data"}. Action: ${error.action}`, "error");
            } else if (error.message && error.message.includes("is not a function")) {
                 showNotif(`Error loading game data: A contract function was not found. ABI issue? (${error.message})`, "error");
            } else {
                showNotif("Failed to load game data. Ensure you are on the correct network.", "error");
            }
        }
    }, [contract, userAddress, formatEth]);

    useEffect(() => {
        if (contract && userAddress) {
            loadGameData();
        }
    }, [contract, userAddress, loadGameData]);
    
    useEffect(() => {
        if (window.ethereum) {
            const handleAccountsChanged = (accounts) => {
                if (accounts.length === 0) {
                    setUserAddress(null); setSigner(null); setContract(null); setIsAdmin(false);
                    showNotif("Wallet disconnected or locked.", "error");
                } else { connectWallet(); }
            };
            const handleChainChanged = (_chainId) => {
                showNotif("Network changed. Re-initializing...", "success");
                connectWallet();
            };

            window.ethereum.on('accountsChanged', handleAccountsChanged);
            window.ethereum.on('chainChanged', handleChainChanged);

            return () => {
                if (window.ethereum.removeListener) { 
                    window.ethereum.removeListener('accountsChanged', handleAccountsChanged);
                    window.ethereum.removeListener('chainChanged', handleChainChanged);
                }
            };
        }
    }, [connectWallet]);

    const handleFetchRoundDetails = async () => {
        if (!contract || !queryRoundId) {
            showNotif("Please enter a Round ID to query.", "error"); return;
        }
        try {
            const roundData = await contract.rounds(queryRoundId);
            if (roundData.roundEndTime.toString() === "0") {
                showNotif(`Round ${queryRoundId} not found or not initialized.`, "error");
                setQueriedRoundInfo(null); return;
            }
            setQueriedRoundInfo({
                predictionDeadline: formatTimestamp(roundData.predictionDeadline),
                roundEndTime: formatTimestamp(roundData.roundEndTime),
                isResolved: roundData.resolved ? "Yes" : "No",
            });
        } catch (error) {
            console.error("Error fetching round details:", error);
            showNotif("Failed to fetch round details. The round might not exist.", "error");
            setQueriedRoundInfo(null);
        }
    };

    const handlePlaceBet = async (event) => {
        event.preventDefault(); 
        if (!contract) { showNotif("Contract not initialized. Please connect wallet.", "error"); return; }
        const betRoundId = event.target.betRoundId.value;
        const predictionStr = event.target.prediction.value;
        if (!betRoundId || !predictionStr) { showNotif("Please fill in all fields for betting (Round ID and Prediction).", "error"); return; }
        const predictionValue = parseFloat(predictionStr);
        const rawPrediction = Math.round(predictionValue * (10**4)); 
        try {
            const currentEntryFee = await contract.entryFee();
            showNotif("Submitting your bet... Please confirm in your wallet.", "success");
            const tx = await contract.placeBet(rawPrediction, betRoundId, { value: currentEntryFee });
            await tx.wait(); 
            showNotif("Bet placed successfully!", "success");
            loadGameData(); 
        } catch (error) {
            console.error("Error placing bet:", error);
            showNotif(`Error placing bet: ${error?.data?.message || error.message || 'Transaction rejected or failed.'}`, "error");
        }
    };
    
    const handleClaimPrize = async (event) => {
        event.preventDefault();
        if (!contract) { showNotif("Contract not initialized. Please connect wallet.", "error"); return; }
        const claimRoundId = event.target.claimRoundId.value;
        if (!claimRoundId) { showNotif("Please enter the Round ID to claim your prize.", "error"); return; }
        try {
            showNotif("Attempting to claim prize... Please confirm in your wallet.", "success");
            const tx = await contract.claimPrize(claimRoundId);
            await tx.wait();
            showNotif("Prize claimed successfully!", "success");
        } catch (error) {
            console.error("Error claiming prize:", error);
            showNotif(`Error claiming prize: ${error?.data?.message || error.message || 'Transaction rejected or failed.'}`, "error");
        }
    };

    const handleCreateRound = async (event) => {
        event.preventDefault();
        if (!contract) return;
        const endTimeVal = event.target.roundEndTimeAdmin.value;
        const deadlineVal = event.target.predictionDeadlineAdmin.value;
        const endTime = Math.floor(new Date(endTimeVal).getTime() / 1000);
        const deadline = Math.floor(new Date(deadlineVal).getTime() / 1000);
        try {
            showNotif("Creating new round... Please confirm in your wallet.", "success");
            const tx = await contract.createRound(endTime, deadline);
            await tx.wait();
            showNotif("Round created successfully!", "success");
            loadGameData(); 
        } catch (error) {
            console.error("Error creating round:", error);
            showNotif(`Error creating round: ${error?.data?.message || error.message || 'Transaction rejected or failed.'}`, "error");
        }
    };
    
    const handleResolveRound = async (event) => {
        event.preventDefault();
        if (!contract) return;
        const roundId = event.target.resolveRoundIdAdmin.value;
        if (!roundId) { showNotif("Please enter the Round ID to resolve.", "error"); return; }
        try {
            showNotif(`Resolving round ${roundId}... Please confirm in your wallet.`, "success");
            const tx = await contract.resolveRound(roundId);
            await tx.wait();
            showNotif(`Round ${roundId} resolved successfully!`, "success");
        } catch (error) {
            console.error("Error resolving round:", error);
            showNotif(`Error resolving round: ${error?.data?.message || error.message || 'Transaction rejected or failed.'}`, "error");
        }
    };

    const handleSetGatingToken = async (event) => {
        event.preventDefault();
        if (!contract || typeof ethers === 'undefined' || !ethers.ZeroAddress) { 
            showNotif("Ethers.js (v6) not loaded or contract not initialized.", "error"); return; 
        }
        const tokenAddress = event.target.gatingTokenAddress.value || ethers.ZeroAddress;
        const minBalanceStr = event.target.minGatingTokenBalance.value;
        const minBalance = minBalanceStr ? BigInt(minBalanceStr) : BigInt(0);
        try {
            showNotif("Setting gating token parameters... Please confirm in your wallet.", "success");
            const tx = await contract.setGatingToken(tokenAddress, minBalance);
            await tx.wait();
            showNotif("Gating token parameters set successfully!", "success");
            loadGameData(); 
        } catch (error) {
            console.error("Error setting gating token:", error);
            showNotif(`Error setting gating token: ${error?.data?.message || error.message || 'Transaction rejected or failed.'}`, "error");
        }
    };

    const handleToggleGating = async () => {
        if (!contract) return;
        try {
            // UPDATED: Call the function with lowercase 't'
            const currentStatus = await contract.tokenGatingEnabled();
            showNotif(`Attempting to ${currentStatus ? "disable" : "enable"} token gating... Please confirm.`, "success");
            const tx = await contract.toggleTokenGating(!currentStatus);
            await tx.wait();
            showNotif(`Token gating ${!currentStatus ? "enabled" : "disabled"} successfully!`, "success");
            loadGameData(); 
        } catch (error) {
            console.error("Error toggling token gating:", error);
            showNotif(`Error toggling token gating: ${error?.data?.message || error.message || 'Transaction rejected or failed.'}`, "error");
        }
    };
    
    const handleSetEntryFee = async (event) => {
        event.preventDefault();
        if (!contract || typeof ethers === 'undefined' || !ethers.parseEther) return; 
        const feeStr = event.target.newEntryFee.value;
        if (!feeStr) { showNotif("Please enter a new entry fee.", "error"); return; }
        const fee = ethers.parseEther(feeStr);
        try {
            showNotif("Setting new entry fee... Please confirm in your wallet.", "success");
            const tx = await contract.setEntryFee(fee);
            await tx.wait();
            showNotif("Entry fee updated successfully!", "success");
            loadGameData(); 
        } catch (error) {
            console.error("Error setting entry fee:", error);
            showNotif(`Error setting entry fee: ${error?.data?.message || error.message || 'Transaction rejected or failed.'}`, "error");
        }
    };

    const handleSetPrizePoolPercentage = async (event) => {
        event.preventDefault();
        if (!contract) return;
        const percentageStr = event.target.newPrizePoolPercentage.value;
        if (!percentageStr) { showNotif("Please enter a prize pool percentage.", "error"); return; }
        const percentage = parseInt(percentageStr);
        try {
            showNotif("Setting prize pool percentage... Please confirm in your wallet.", "success");
            const tx = await contract.setPrizePoolPercentage(percentage);
            await tx.wait();
            showNotif("Prize pool percentage updated successfully!", "success");
            loadGameData(); 
        } catch (error) {
            console.error("Error setting prize pool %:", error);
            showNotif(`Error setting prize pool %: ${error?.data?.message || error.message || 'Transaction rejected or failed.'}`, "error");
        }
    };
    
    const handleSetMaxBetAmount = async (event) => {
        event.preventDefault();
        if (!contract || typeof ethers === 'undefined' || !ethers.parseEther) return; 
        const amountStr = event.target.newMaxBetAmount.value;
        if(!amountStr) { showNotif("Please enter a new max bet amount.", "error"); return; }
        const amount = ethers.parseEther(amountStr);
        try {
            showNotif("Setting max bet amount... Please confirm in your wallet.", "success");
            const tx = await contract.setMaxBetAmount(amount);
            await tx.wait();
            showNotif("Max bet amount updated successfully!", "success");
            loadGameData(); 
        } catch (error) {
            console.error("Error setting max bet amount:", error);
            showNotif(`Error setting max bet: ${error?.data?.message || error.message || 'Transaction rejected or failed.'}`, "error");
        }
    };
    
    const handleSetOracleAddress = async (event) => {
        event.preventDefault();
        if (!contract) return;
        const newAddress = event.target.newOracleAddress.value;
        if(!newAddress) { showNotif("Please enter a new oracle address.", "error"); return; }
        try {
            showNotif("Setting new oracle address... Please confirm in your wallet.", "success");
            const tx = await contract.setOracleAddress(newAddress);
            await tx.wait();
            showNotif("Oracle address updated successfully!", "success");
        } catch (error) {
            console.error("Error setting oracle address:", error);
            showNotif(`Error setting oracle: ${error?.data?.message || error.message || 'Transaction rejected or failed.'}`, "error");
        }
    };

    const handlePauseGame = async () => {
        if (!contract) return;
        try {
            showNotif("Pausing game... Please confirm in your wallet.", "success");
            const tx = await contract.pauseGame();
            await tx.wait();
            showNotif("Game paused successfully!", "success");
            loadGameData(); 
        } catch (error) {
            console.error("Error pausing game:", error);
            showNotif(`Error pausing game: ${error?.data?.message || error.message || 'Transaction rejected or failed.'}`, "error");
        }
    };

    const handleUnpauseGame = async () => {
        if (!contract) return;
        try {
            showNotif("Unpausing game... Please confirm in your wallet.", "success");
            const tx = await contract.unpauseGame();
            await tx.wait();
            showNotif("Game unpaused successfully!", "success");
            loadGameData(); 
        } catch (error) {
            console.error("Error unpausing game:", error);
            showNotif(`Error unpausing game: ${error?.data?.message || error.message || 'Transaction rejected or failed.'}`, "error");
        }
    };

    const handleWithdrawAdminFees = async (event) => {
        event.preventDefault();
        if (!contract) return;
        const toAddress = event.target.withdrawToAddress.value;
        if(!toAddress) { showNotif("Please enter the address to withdraw fees to.", "error"); return; }
        try {
            showNotif("Withdrawing admin fees... Please confirm in your wallet.", "success");
            const tx = await contract.withdrawAdminFees(toAddress);
            await tx.wait();
            showNotif("Admin fees withdrawn successfully!", "success");
        } catch (error) {
            console.error("Error withdrawing fees:", error);
            showNotif(`Error withdrawing fees: ${error?.data?.message || error.message || 'Transaction rejected or failed.'}`, "error");
        }
    };

    if (typeof ethers === 'undefined' && typeof window.ethers === 'undefined' && !ethers) {
        return <div className="p-8 text-center text-red-500">Ethers.js library is not available. Please ensure it's included or installed.</div>;
    }

    return (
        <div className="bg-gray-100 text-gray-800 min-h-screen p-4 md:p-8 font-['Inter',_sans-serif]">
            <div className="container mx-auto max-w-6xl">
                <header className="mb-8 p-6 bg-white rounded-lg shadow-md flex flex-col sm:flex-row justify-between items-center">
                    <h1 className="text-3xl font-bold text-blue-600 mb-4 sm:mb-0">BTC Price Prediction Game</h1>
                    <div>
                        {networkInfo.name && <p className="text-sm text-gray-600 mb-1 text-right">{networkInfo.name} (ID: {networkInfo.chainId})</p>}
                        {!userAddress ? (
                            <Button onClick={connectWallet} disabled={typeof ethers === 'undefined'}>Connect Wallet</Button>
                        ) : (
                            <p id="walletAddress" className="text-sm text-gray-700 font-medium mt-1 text-right">
                                Connected: {userAddress.substring(0, 6)}...{userAddress.substring(userAddress.length - 4)}
                            </p>
                        )}
                    </div>
                </header>

                <Notification message={notification.message} type={notification.type} onDismiss={() => setNotification({ message: '', type: '' })} />

                <div className="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                    <Card title="Current Round Info">
                        <p className="text-sm mb-1"><strong>Contract:</strong> 
                            <a href={`${blockExplorerUrl}/address/${contractAddress}`} target="_blank" rel="noopener noreferrer" className="text-blue-500 hover:underline ml-1 break-all">
                                {contractAddress}
                            </a>
                        </p>
                        <p className="text-sm mb-1"><strong>Next Round ID to Create:</strong> <span className="font-semibold">{nextRoundId}</span></p>
                        <p className="text-sm mb-1"><strong>Latest Created Round ID:</strong> <span className="font-semibold">{latestCreatedRoundId}</span></p>
                        <p className="text-sm mb-1"><strong>Entry Fee:</strong> <span className="font-semibold">{entryFee} ETH</span></p>
                        <p className="text-sm mb-3"><strong>Game Paused:</strong> <span className="font-semibold">{gamePaused}</span></p>
                        <hr className="my-4"/>
                        <h3 className="text-gray-700 text-lg font-semibold mb-2">Query Round Details</h3>
                        <div className="mb-3 flex items-end gap-2">
                            <div className="flex-grow">
                                <Input label="Round ID:" id="queryRoundIdInput" type="number" value={queryRoundId} onChange={e => setQueryRoundId(e.target.value)} placeholder="Enter round ID" />
                            </div>
                            <Button onClick={handleFetchRoundDetails} variant="secondary" className="mb-4 h-10" disabled={!contract}>Fetch</Button>
                        </div>
                        {queriedRoundInfo && (
                            <div className="text-sm space-y-1 bg-gray-50 p-3 rounded-md">
                                <p><strong>Prediction Deadline:</strong> {queriedRoundInfo.predictionDeadline}</p>
                                <p><strong>Round End Time:</strong> {queriedRoundInfo.roundEndTime}</p>
                                <p><strong>Is Resolved:</strong> {queriedRoundInfo.isResolved}</p>
                            </div>
                        )}
                    </Card>

                    <Card title="Player Actions">
                        <form onSubmit={handlePlaceBet} className="mb-6">
                            <h3 className="text-lg font-semibold mb-3 text-gray-700">Place Your Bet</h3>
                            <Input label="Round ID to Bet On:" id="betRoundId" name="betRoundId" type="number" required />
                            <Input label="Your BTC Price Prediction (e.g., 65000.1234):" id="prediction" name="prediction" type="number" step="0.0001" required />
                            <Button type="submit" className="w-full" disabled={!contract || gamePaused === "Yes"}>Place Bet</Button>
                        </form>
                        <hr className="my-4"/>
                        <form onSubmit={handleClaimPrize}>
                             <h3 className="text-lg font-semibold mb-3 text-gray-700">Claim Prize</h3>
                            <Input label="Round ID to Claim From:" id="claimRoundId" name="claimRoundId" type="number" required />
                            <Button type="submit" className="w-full" disabled={!contract}>Claim Prize</Button>
                        </form>
                    </Card>
                </div>

                {isAdmin && (
                    <Card title="Admin Panel" titleColor="text-amber-500" className="border-l-4 border-amber-400">
                        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                            <Card title="Create Round" titleColor="text-gray-700" className="bg-gray-50">
                                <form onSubmit={handleCreateRound}>
                                    <Input label="Round End Time:" id="roundEndTimeAdmin" name="roundEndTimeAdmin" type="datetime-local" required />
                                    <Input label="Prediction Deadline:" id="predictionDeadlineAdmin" name="predictionDeadlineAdmin" type="datetime-local" required />
                                    <Button type="submit" className="w-full">Create Round</Button>
                                </form>
                            </Card>
                            <Card title="Resolve Round" titleColor="text-gray-700" className="bg-gray-50">
                                <form onSubmit={handleResolveRound}>
                                    <Input label="Round ID to Resolve:" id="resolveRoundIdAdmin" name="resolveRoundIdAdmin" type="number" required />
                                    <Button type="submit" variant="warning" className="w-full">Resolve Round</Button>
                                </form>
                            </Card>
                            <Card title="Token Gating" titleColor="text-gray-700" className="bg-gray-50">
                                <form onSubmit={handleSetGatingToken} className="mb-4">
                                    <Input label="Gating Token Address (ERC20):" id="gatingTokenAddress" name="gatingTokenAddress" placeholder="0x... (leave blank to clear)" />
                                    <Input label="Min. Token Balance (raw amount):" id="minGatingTokenBalance" name="minGatingTokenBalance" type="text" placeholder="e.g., 1000000000000000000" />
                                    <Button type="submit" variant="secondary" className="w-full">Set Gating Token</Button>
                                </form>
                                <div className="flex items-center justify-between mb-2">
                                    <span className="text-sm">Enable Token Gating:</span>
                                    <Button onClick={handleToggleGating} variant="secondary" className="px-3 py-1 text-xs">{gatingEnabled ? "Disable" : "Enable"}</Button>
                                </div>
                                <p className="text-xs mt-1">Status: <span className="font-medium">{gatingEnabled ? "Enabled" : "Disabled"}</span></p>
                                <p className="text-xs mt-1">Token: <span className="font-medium break-all">{gatingTokenDisplay}</span></p>
                                <p className="text-xs mt-1">Min Balance: <span className="font-medium">{gatingMinBalanceDisplay}</span></p>
                            </Card>
                             <Card title="Game Settings" titleColor="text-gray-700" className="bg-gray-50">
                                <form onSubmit={handleSetEntryFee} className="mb-3">
                                    <Input label="New Entry Fee (ETH):" id="newEntryFee" name="newEntryFee" type="number" step="any" required />
                                    <Button type="submit" variant="secondary" className="w-full text-sm">Set Entry Fee</Button>
                                </form>
                                <form onSubmit={handleSetPrizePoolPercentage} className="mb-3">
                                    <Input label="Prize Pool % (0-100):" id="newPrizePoolPercentage" name="newPrizePoolPercentage" type="number" min="0" max="100" required />
                                    <Button type="submit" variant="secondary" className="w-full text-sm">Set Prize %</Button>
                                </form>
                                <form onSubmit={handleSetMaxBetAmount} className="mb-3">
                                    <Input label="New Max Bet Amount (ETH):" id="newMaxBetAmount" name="newMaxBetAmount" type="number" step="any" required />
                                    <Button type="submit" variant="secondary" className="w-full text-sm">Set Max Bet</Button>
                                </form>
                                <form onSubmit={handleSetOracleAddress}>
                                    <Input label="New Oracle Address:" id="newOracleAddress" name="newOracleAddress" placeholder="0x..." required />
                                    <Button type="submit" variant="secondary" className="w-full text-sm">Set Oracle</Button>
                                </form>
                            </Card>
                            <Card title="Maintenance" titleColor="text-gray-700" className="bg-gray-50">
                                <Button onClick={handlePauseGame} variant="warning" className="w-full mb-2">Pause Game</Button>
                                <Button onClick={handleUnpauseGame} variant="warning" className="w-full mb-4">Unpause Game</Button>
                                <form onSubmit={handleWithdrawAdminFees}>
                                    <Input label="Withdraw Fees To Address:" id="withdrawToAddress" name="withdrawToAddress" placeholder="0x..." required defaultValue={userAddress || ''}/>
                                    <Button type="submit" variant="danger" className="w-full">Withdraw Admin Fees</Button>
                                </form>
                            </Card>
                        </div>
                    </Card>
                )}
            </div>
        </div>
    );
}

export default App;


